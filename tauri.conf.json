{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MAX File Recovery",
  "mainBinaryName": "max-recovery",
  "version": "0.1.0",
  "identifier": "com.maxrecovery.app",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "MAX File Recovery",
        "width": 1400,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 680,
        "center": true,
        "visible": false,
        "backgroundColor": "#F3F2F7"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "MAX File Recovery",
    "copyright": "© 2026 MAX File Recovery",
    "category": "Utility",
    "shortDescription": "Find, preview and safely restore lost files",
    "longDescription": "MAX File Recovery finds deleted, lost and formatted files on NTFS, FAT and exFAT drives, memory cards and disk images, shows how intact each one is, previews it, and copies it to another drive without ever writing to the source.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "allowDowngrades": false,
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer/hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false,
        "compression": "lzma"
      }
    }
  }
}
